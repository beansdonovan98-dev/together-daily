require 'json'

default_platform(:ios)

platform :ios do
  desc "Create or refresh App Store signing assets in the match repo"

  lane :bootstrap_match do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    match(
      type: "appstore",
      readonly: false,
      api_key: api_key
    )
  end

  desc "Build and upload to TestFlight"

  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key
    )

    profile_name = JSON.parse(ENV["MATCH_PROVISIONING_PROFILE_MAPPING"])["com.app.togetherdaily"]

    update_project_team(
      path: "TogetherDaily.xcodeproj",
      teamid: "PKM33XZW3X"
    )
    update_code_signing_settings(
      path: "TogetherDaily.xcodeproj",
      use_automatic_signing: false,
      team_id: "PKM33XZW3X",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      scheme: "TogetherDaily",
      workspace: "TogetherDaily.xcworkspace",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: "PKM33XZW3X",
      output_directory: "build",
      output_name: "TogetherDaily.ipa",
      build_path: "build",
      derived_data_path: "build/DerivedData",
      clean: true,
      disable_package_automatic_updates: true,
      export_options: {
        method: "app-store",
        teamID: "PKM33XZW3X",
        signingStyle: "manual",
        provisioningProfiles: {
          "com.app.togetherdaily" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
